{
  "name": "@revclamp/google-ads-transparency-mcp",
  "mcpName": "com.revclamp/google-ads-transparency-mcp",
  "version": "1.0.16",
  "type": "module",
  "description": "Google Ads Transparency Center and Google Ad Library scraper & MCP server. Find verified advertiser entities and extract active or historical ad creatives (Text, Image, Video), preview links, and run dates. Independent tool by RevClamp.",
  "homepage": "https://revclamp.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lhphong09t2/revclamp-mcp.git",
    "directory": "products/google-ads-transparency-mcp"
  },
  "license": "MIT",
  "main": "./index.mjs",
  "bin": {
    "google-ads-transparency-mcp": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "src/",
    "assets/",
    "actor_config.json",
    "server.json",
    "glama.json",
    ".well-known/",
    ".actor/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "google-ads",
    "ads-transparency",
    "ad-intelligence",
    "competitive-intelligence",
    "ad-library",
    "brand-safety",
    "ppc",
    "b2b-marketing",
    "revclamp"
  ],
  "scripts": {
    "start": "node ./index.mjs",
    "mcp": "node ./index.mjs --mcp-stdio",
    "playground": "node ./src/web_preview_server.mjs",
    "preview": "node ./index.mjs --web-preview",
    "self-test": "node ./index.mjs --self-test",
    "list-tools": "node ./index.mjs --list-tools",
    "test": "node --test ./test/google_ads_transparency.test.mjs ./test/metamorphic_and_mutation.test.mjs ./test/cdp_zero_false_green_e2e.test.mjs",
    "release:audit": "node ./scripts/release_publisher.mjs --audit"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
